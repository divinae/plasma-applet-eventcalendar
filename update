#!/usr/bin/env bash
if [ -z "${BASH_VERSION:-}" ]; then
    exec /usr/bin/env bash "$0" "$@"
fi

set -euo pipefail

# Pulls master and reinstalls. ./install does the fetch / pull, the dependencies
# and the package copy; this only refuses a dirty tree first (./install would
# skip the pull and reinstall the local changes instead).

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"
}

if ! git rev-parse --git-dir > /dev/null 2>&1; then
    log "ERROR: Not in a git repository"
    exit 1
fi

if ! git diff --quiet || ! git diff --cached --quiet; then
    log "ERROR: Uncommitted changes detected. Please commit or stash before updating."
    exit 1
fi

exec bash ./install --restart
