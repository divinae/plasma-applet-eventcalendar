msgstr "Например, дата"

#: ../contents/ui/config/ConfigClock.qml
msgid "Size"
msgstr "Размер"

#: ../contents/ui/config/ConfigClock.qml
msgid "Next Meeting"
msgstr "Следующая встреча"

#: ../contents/ui/config/ConfigClock.qml
msgid "Show next to the clock"
msgstr "Показывать рядом с часами"

#: ../contents/ui/config/ConfigClock.qml
msgid "When it starts within"
msgstr "Если начинается в течение"

#: ../contents/ui/config/ConfigClock.qml
msgid " min"
msgstr " мин"

#: ../contents/ui/config/ConfigClock.qml
msgid "Progress of the current meeting"
msgstr "Прогресс текущей встречи"

#: ../contents/ui/config/ConfigClock.qml
msgid "A thin bar under the meeting's name, in its calendar's color."
msgstr "Тонкая полоса под названием встречи в цвете ее календаря."

#: ../contents/ui/config/ConfigClock.qml
msgid "Middle-click the clock to join the current or next meeting."
msgstr ""
"Щелчок средней кнопкой мыши по часам — подключиться к текущей или следующей "
"встрече."

#: ../contents/ui/config/ConfigClock.qml
msgid "Show background"
msgstr "Показывать фон"

#: ../contents/ui/config/ConfigClock.qml
msgid "Desktop widget"
msgstr "Виджет на рабочем столе"

#: ../contents/ui/config/ConfigClock.qml
msgid "Debug logging and extra settings pages"
msgstr "Журнал отладки и дополнительные страницы настроек"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Refresh every"
msgstr "Обновлять каждые"

#: ../contents/ui/config/ConfigEvents.qml
