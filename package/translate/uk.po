#: ../contents/ui/config/ConfigClock.qml
msgid "When it starts within"
msgstr "Якщо починається протягом"

#: ../contents/ui/config/ConfigClock.qml
msgid " min"
msgstr " хв"

#: ../contents/ui/config/ConfigClock.qml
msgid "Progress of the current meeting"
msgstr "Поступ поточної зустрічі"

#: ../contents/ui/config/ConfigClock.qml
msgid "A thin bar under the meeting's name, in its calendar's color."
msgstr "Тонка смужка під назвою зустрічі, у кольорі її календаря."

#: ../contents/ui/config/ConfigClock.qml
msgid "Middle-click the clock to join the current or next meeting."
msgstr ""
"Клацніть середньою кнопкою миші на годиннику, щоб приєднатися до поточної "
"або наступної зустрічі."

#: ../contents/ui/config/ConfigClock.qml
