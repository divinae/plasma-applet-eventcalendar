msgstr[0] "%1 secondo"
msgstr[1] "%1 secondi"

#: ../contents/ui/config/ConfigEvents.qml
msgctxt "notification timeout"
msgid "System default"
msgstr "Predefinito di sistema"

#: ../contents/ui/config/ConfigEvents.qml
msgid "System default: as set in System Settings > Notifications. A reminder hidden after a set time isn't kept in the notification history."
msgstr "Predefinito di sistema: come impostato in Impostazioni di sistema > Notifiche. Un promemoria nascosto dopo un tempo fisso non resta nella cronologia delle notifiche."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Snooze"
msgstr "Posticipa"

#: ../contents/ui/config/ConfigEvents.qml
msgid "0 = no Snooze button"
msgstr "0 = nessun pulsante Posticipa"

#: ../contents/ui/config/ConfigEvents.qml ../contents/ui/TimerView.qml
msgid "Sound"
msgstr "Suono"

#: ../contents/ui/config/ConfigEvents.qml
msgid "When an Event Starts"
msgstr "All'inizio di un evento"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Show a notification"
msgstr "Mostra una notifica"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Critical"
msgstr "Critica"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Shown even in Do Not Disturb"
msgstr "Mostrata anche in modalità Non disturbare"

#: ../contents/ui/config/ConfigEvents.qml
msgid "\"Join meeting\" button"
msgstr "Pulsante «Partecipa alla riunione»"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Meetings"
msgstr "Riunioni"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Open the meeting link when a meeting starts"
msgstr "Apri il link della riunione quando inizia"

#: ../contents/ui/config/ConfigEvents.qml
msgid "For meetings you accepted or organize, not marked as ended."
msgstr "Per le riunioni che hai accettato o che organizzi, non segnate come terminate."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Pause music and videos when joining a meeting"
msgstr "Metti in pausa musica e video quando partecipi a una riunione"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Players that are playing (eg: Spotify, Elisa, a video in the browser), when a Join button opens a meeting or it opens when the meeting starts."
msgstr "Lettori in riproduzione (es.: Spotify, Elisa, un video nel browser), quando un pulsante Partecipa apre una riunione o si apre all'inizio della riunione."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Do Not Disturb during meetings"
msgstr "Non disturbare durante le riunioni"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Plasma's Do Not Disturb from the start until the end of a meeting with guests or a meeting link. Mark as Ended turns it off."
msgstr "La modalità Non disturbare di Plasma dall'inizio alla fine di una riunione con invitati o con un link. «Segna come terminata» la disattiva."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Only meetings I accepted"
msgstr "Solo le riunioni che ho accettato"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Open Google Meet links in"
msgstr "Apri i link di Google Meet in"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Default browser"
msgstr "Browser predefinito"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Other command…"
msgstr "Altro comando…"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Command"
msgstr "Comando"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Google account"
msgstr "Account Google"

#: ../contents/ui/config/ConfigEvents.qml ../contents/ui/config/ConfigViews.qml
msgid "Default"
msgstr "Predefinito"

#: ../contents/ui/config/ConfigEvents.qml
#, c-format
msgid "Join buttons open Google Meet links there; other meeting links open in the default browser. In a command, %u stands for the meeting link. Google account: its number (0, 1, …) or email, as in Google's account switcher; empty uses the app's default."
msgstr "I pulsanti Partecipa aprono lì i link di Google Meet; gli altri link delle riunioni si aprono nel browser predefinito. In un comando, %u indica il link della riunione. Account Google: il suo numero (0, 1, …) o la sua email, come nel selettore account di Google; vuoto usa il predefinito dell'applicazione."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Other Notifications"
msgstr "Altre notifiche"

#: ../contents/ui/config/ConfigEvents.qml
msgid "New invitations for today"
msgstr "Nuovi inviti per oggi"

#: ../contents/ui/config/ConfigEvents.qml
msgid "A notification for each meeting today you haven't answered yet, with Yes, Maybe and No."
msgstr "Una notifica per ogni riunione di oggi a cui non hai ancora risposto, con Sì, Forse e No."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Today's events every morning"
msgstr "Gli eventi di oggi ogni mattina"

#: ../contents/ui/config/ConfigEvents.qml
msgid "A notification with today's events once a day, also when the computer is turned on later."
msgstr "Una notifica con gli eventi di oggi una volta al giorno, anche se il computer viene acceso più tardi."

#: ../contents/ui/config/ConfigEvents.qml
msgid "At"
msgstr "Alle"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Skip all-day events"
msgstr "Salta gli eventi di tutto il giorno"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Skip events I declined"
msgstr "Salta gli eventi che ho rifiutato"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Popups and sounds for each kind of notification can also be set in System Settings > Notifications > Event Calendar."
msgstr "Finestre e suoni per ogni tipo di notifica possono essere impostati anche in Impostazioni di sistema > Notifiche > Event Calendar."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Google Account"
msgstr "Account Google"

#: ../contents/ui/config/ConfigGoogleCalendar.qml ../contents/ui/config/ConfigTasks.qml
msgid "Google Account %1"
msgstr "Account Google %1"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Login failed: %1"
msgstr "Accesso non riuscito: %1"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Login complete."
msgstr "Accesso completato."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Could not prepare Google login: %1"
msgstr "Impossibile preparare l'accesso a Google: %1"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Waiting for browser callback..."
msgstr "In attesa della risposta del browser..."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign-in timed out. Try again."
msgstr "Tempo scaduto per l'accesso. Riprova."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed. See logs for details."
msgstr "Accesso automatico non riuscito. Vedi i log per i dettagli."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed: invalid callback data."
msgstr "Accesso automatico non riuscito: dati di callback non validi."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed: %1"
msgstr "Accesso automatico non riuscito: %1"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed: authorization code missing."
msgstr "Accesso automatico non riuscito: codice di autorizzazione mancante."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "The desktop could not open the browser automatically. Use the login link in Advanced sign-in options instead."
msgstr "Il desktop non è riuscito ad aprire automaticamente il browser. Usa invece il collegamento di accesso in Opzioni di accesso avanzate."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign in to show your Google calendars and task lists. Your browser opens to sign in; when access is granted the widget picks it up automatically."
msgstr "Accedi per mostrare i tuoi calendari ed elenchi di attività Google. Il browser si apre per l'accesso; una volta concessa l'autorizzazione, l'oggetto la rileva automaticamente."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign In Again"
msgstr "Accedi di nuovo"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Reload calendars and task lists"
msgstr "Ricarica calendari ed elenchi di attività"

#: ../contents/ui/config/ConfigGoogleCalendar.qml ../contents/ui/config/ConfigTasks.qml
msgid "Remove Account"
msgstr "Rimuovi account"

#: ../contents/ui/config/ConfigGoogleCalendar.qml ../contents/ui/config/ConfigTasks.qml
msgid "Remove"
msgstr "Rimuovi"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Google access for this account expired or was revoked. Sign in again to reconnect it (the account and its settings are kept)."
msgstr "L'accesso a Google per questo account è scaduto o è stato revocato. Accedi di nuovo per ricollegarlo (l'account e le sue impostazioni vengono mantenuti)."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "The widget was updated. Sign in again to keep this account in sync."
msgstr "L'oggetto è stato aggiornato. Accedi di nuovo per mantenere sincronizzato questo account."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "No calendars loaded yet. Use the reload button."
msgstr "Nessun calendario ancora caricato. Usa il pulsante di ricarica."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Task lists are chosen on the Tasks page."
msgstr "Gli elenchi di attività si scelgono nella pagina Attività."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Add Account…"
msgstr "Aggiungi account…"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign in with Google…"
msgstr "Accedi con Google…"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Waiting for the browser sign-in…"
msgstr "In attesa dell'accesso dal browser…"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Advanced sign-in options"
msgstr "Opzioni di accesso avanzate"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Your own Google OAuth client, or pasting the sign-in code by hand"
msgstr "Un tuo client OAuth di Google, oppure l'inserimento manuale del codice di accesso"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Client Credentials"
msgstr "Credenziali del client"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Using a previously stored Google OAuth client for compatibility. If login still fails, add your own client ID and client secret."
msgstr "Per compatibilità viene usato un client OAuth di Google memorizzato in precedenza. Se l'accesso continua a non riuscire, aggiungi il tuo ID client e segreto client."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Try desktop built-in client (no secret)"
msgstr "Prova il client desktop integrato (senza segreto)"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Client ID"
msgstr "ID client"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Optional"
msgstr "Facoltativo"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Client Secret"
msgstr "Segreto client"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Leave these empty to use the built-in client. A custom client must be a Google Cloud OAuth Desktop client, or a Web client with its secret and the redirect URI set to %1."
msgstr "Lascia vuoti questi campi per usare il client integrato. Un client personalizzato deve essere un client OAuth Desktop di Google Cloud, oppure un client Web con il relativo segreto e l'URI di reindirizzamento impostato su %1."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "For a custom OAuth client, publish the OAuth consent screen to Production. Google expires refresh tokens for external apps left in Testing after seven days; Workspace session controls can also require reauthorization."
