#: ../contents/ui/config/ConfigClock.qml
msgid "A thin bar under the meeting's name, in its calendar's color."
msgstr "Una sottile barra sotto il nome della riunione, nel colore del suo calendario."

#: ../contents/ui/config/ConfigClock.qml
msgid "Middle-click the clock to join the current or next meeting."
msgstr "Fai clic con il tasto centrale sull'orologio per partecipare alla riunione attuale o successiva."

#: ../contents/ui/config/ConfigClock.qml
