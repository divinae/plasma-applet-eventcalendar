#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Google Account"
msgstr "Conta do Google"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Google Account %1"
msgstr "Conta do Google %1"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Login failed: %1"
msgstr "Falha no login: %1"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Login complete."
msgstr "Login concluído."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Could not prepare Google login: %1"
msgstr "Não foi possível preparar o login do Google: %1"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Waiting for browser callback..."
msgstr "Aguardando retorno do navegador..."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Waiting for the helper page to send the code..."
msgstr "Aguardando a página auxiliar enviar o código..."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign-in timed out. Try again."
msgstr "O login expirou. Tente novamente."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed. See logs for details."
msgstr "Falha no login automático. Veja os logs para mais detalhes."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed: invalid callback data."
msgstr "Falha no login automático: dados de retorno inválidos."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed: %1"
msgstr "Falha no login automático: %1"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed: authorization code missing."
msgstr "Falha no login automático: código de autorização ausente."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid ""
"The desktop could not open the browser automatically. Use the login link in "
"Advanced sign-in options instead."
msgstr ""
"A área de trabalho não conseguiu abrir o navegador automaticamente. Use o "
"link de login em Opções avançadas de login."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid ""
"Sign in to show your Google calendars and task lists. Your browser opens to "
"sign in; when access is granted the widget picks it up automatically."
msgstr ""
"Entre para mostrar seus calendários e listas de tarefas do Google. O "
"navegador abre para o login; quando o acesso for concedido, o widget o "
"detecta automaticamente."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign In Again"
msgstr "Entrar novamente"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Reload calendars and task lists"
msgstr "Recarregar calendários e listas de tarefas"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Remove Account"
msgstr "Remover conta"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Remove"
msgstr "Remover"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid ""
"Google access for this account expired or was revoked. Sign in again to "
"reconnect it (the account and its settings are kept)."
msgstr ""
"O acesso do Google para esta conta expirou ou foi revogado. Entre novamente "
"para reconectá-la (a conta e suas configurações são mantidas)."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "The widget was updated. Sign in again to keep this account in sync."
msgstr ""
"O widget foi atualizado. Entre novamente para manter esta conta sincronizada."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "No calendars loaded yet. Use the reload button."
msgstr "Nenhum calendário carregado ainda. Use o botão de recarregar."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Task Lists"
msgstr "Listas de tarefas"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Add Account…"
msgstr "Adicionar conta…"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign in with Google…"
msgstr "Entrar com o Google…"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Waiting for the browser sign-in…"
msgstr "Aguardando o login no navegador…"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Advanced sign-in options"
msgstr "Opções avançadas de login"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Your own Google OAuth client, or pasting the sign-in code by hand"
msgstr ""
"Seu próprio cliente OAuth do Google ou colar o código de login manualmente"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Client Credentials"
msgstr "Credenciais do cliente"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid ""
"Using a previously stored Google OAuth client for compatibility. If login "
"still fails, add your own client ID and client secret."
msgstr ""
"Usando um cliente OAuth do Google armazenado anteriormente, por "
"compatibilidade. Se o login ainda falhar, adicione seu próprio ID e segredo "
"do cliente."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Try desktop built-in client (no secret)"
msgstr "Tentar o cliente desktop embutido (sem segredo)"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Client ID"
msgstr "ID do cliente"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Optional"
msgstr "Opcional"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Client Secret"
msgstr "Segredo do cliente"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid ""
"Leave these empty to use the built-in client. A custom client must be a "
"Google Cloud OAuth Desktop client, or a Web client with its secret and the "
"redirect URI set to %1."
msgstr ""
"Deixe estes campos vazios para usar o cliente embutido. Um cliente "
"personalizado deve ser um cliente OAuth do tipo Desktop do Google Cloud, ou "
"um cliente Web com seu segredo e o URI de redirecionamento definido como %1."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid ""
"For a custom OAuth client, publish the OAuth consent screen to Production. "
"Google expires refresh tokens for external apps left in Testing after seven "
"days; Workspace session controls can also require reauthorization."
msgstr ""
"Para um cliente OAuth personalizado, publique a tela de consentimento OAuth "
"em Produção. O Google expira os tokens de atualização de apps externos "
"deixados em Teste após sete dias; os controles de sessão do Workspace também "
"podem exigir nova autorização."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Manual Sign-in"
msgstr "Login manual"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Login (Auto) - Add Account"
msgstr "Login (automático) - Adicionar conta"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Login (Auto)"
msgstr "Login (automático)"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid ""
"Click Login (Auto) to open <a href=\"%1\">%2</a>. After you grant access, "
"the browser redirects to a localhost URL. If auto-capture succeeds you can "
"ignore the field below; otherwise copy the full URL (or just the code) and "
"paste it."
msgstr ""
"Clique em Login (automático) para abrir <a href=\"%1\">%2</a>. Depois de "
"conceder o acesso, o navegador redireciona para uma URL localhost. Se a "
"captura automática funcionar, você pode ignorar o campo abaixo; caso "
"contrário, copie a URL completa (ou apenas o código) e cole-a."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid ""
"Click Login (Auto) to open <a href=\"%1\">%2</a>. After you grant access, "
"the browser redirects to the helper page and will try to send the code back "
"automatically. If it fails, copy the code and paste it below."
msgstr ""
"Clique em Login (automático) para abrir <a href=\"%1\">%2</a>. Depois de "
"conceder o acesso, o navegador redireciona para a página auxiliar e tentará "
"enviar o código de volta automaticamente. Se falhar, copie o código e cole-o "
"abaixo."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "The desktop could not open the browser automatically."
msgstr "A área de trabalho não conseguiu abrir o navegador automaticamente."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Copy Link"
msgstr "Copiar Link"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Helper page (optional): <a href=\"%1\">%1</a>"
msgstr "Página auxiliar (opcional): <a href=\"%1\">%1</a>"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Helper page: <a href=\"%1\">%1</a>"
msgstr "Página auxiliar: <a href=\"%1\">%1</a>"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid ""
"If your browser shows a connection error, that's expected. Copy the URL from "
"the address bar anyway and paste it below. If auto-capture works, you do not "
"need to paste anything."
msgstr ""
"Se o navegador mostrar um erro de conexão, isso é esperado. Copie mesmo "
"assim a URL da barra de endereços e cole-a abaixo. Se a captura automática "
"funcionar, você não precisa colar nada."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid ""
"If auto-capture fails, copy the code from the helper page and paste it below."
msgstr ""
"Se a captura automática falhar, copie o código da página auxiliar e cole-o "
"abaixo."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Paste the authorization code or redirect URL here"
msgstr "Cole aqui o código de autorização ou a URL de redirecionamento"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Google authorization code or redirect URL"
msgstr "Código de autorização do Google ou URL de redirecionamento"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid ""
"Paste the Google authorization code or the full redirect URL from the browser"
msgstr ""
"Cole o código de autorização do Google ou a URL de redirecionamento completa "
"do navegador"

