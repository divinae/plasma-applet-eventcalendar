msgstr[0] "%1 segundo"
msgstr[1] "%1 segundos"

#: ../contents/ui/config/ConfigEvents.qml
msgctxt "notification timeout"
msgid "System default"
msgstr "Padrão do sistema"

#: ../contents/ui/config/ConfigEvents.qml
msgid ""
"System default: as set in System Settings > Notifications. A reminder hidden "
"after a set time isn't kept in the notification history."
msgstr ""
"Padrão do sistema: conforme as Configurações do sistema > Notificações. Um "
"lembrete ocultado após um tempo fixo não fica no histórico de notificações."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Snooze"
msgstr "Adiar"

#: ../contents/ui/config/ConfigEvents.qml
msgid "0 = no Snooze button"
msgstr "0 = sem botão Adiar"

#: ../contents/ui/config/ConfigEvents.qml ../contents/ui/TimerView.qml
msgid "Sound"
msgstr "Som"

#: ../contents/ui/config/ConfigEvents.qml
msgid "When an Event Starts"
msgstr "Quando um evento começar"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Show a notification"
msgstr "Mostrar uma notificação"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Critical"
msgstr "Crítica"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Shown even in Do Not Disturb"
msgstr "Exibida mesmo no modo Não perturbe"

#: ../contents/ui/config/ConfigEvents.qml
msgid "\"Join meeting\" button"
msgstr "Botão \"Participar da reunião\""

#: ../contents/ui/config/ConfigEvents.qml
msgid "Meetings"
msgstr "Reuniões"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Open the meeting link when a meeting starts"
msgstr "Abrir o link da reunião quando ela começar"

#: ../contents/ui/config/ConfigEvents.qml
msgid "For meetings you accepted or organize, not marked as ended."
msgstr ""
"Para reuniões que você aceitou ou organiza, não marcadas como encerradas."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Pause music and videos when joining a meeting"
msgstr "Pausar músicas e vídeos ao participar de uma reunião"

#: ../contents/ui/config/ConfigEvents.qml
msgid ""
"Players that are playing (eg: Spotify, Elisa, a video in the browser), when "
"a Join button opens a meeting or it opens when the meeting starts."
msgstr ""
"Players que estão tocando (ex.: Spotify, Elisa, um vídeo no navegador), "
"quando um botão Participar abre uma reunião ou ela abre no início."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Do Not Disturb during meetings"
msgstr "Não perturbe durante reuniões"

#: ../contents/ui/config/ConfigEvents.qml
msgid ""
"Plasma's Do Not Disturb from the start until the end of a meeting with "
"guests or a meeting link. Mark as Ended turns it off."
msgstr ""
"O \"Não perturbe\" do Plasma do início ao fim de uma reunião com convidados "
"ou com link de reunião. \"Marcar como encerrada\" o desativa."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Only meetings I accepted"
msgstr "Somente reuniões que aceitei"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Open Google Meet links in"
msgstr "Abrir links do Google Meet em"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Default browser"
msgstr "Navegador padrão"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Other command…"
msgstr "Outro comando…"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Command"
msgstr "Comando"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Google account"
msgstr "Conta do Google"

#: ../contents/ui/config/ConfigEvents.qml ../contents/ui/config/ConfigViews.qml
msgid "Default"
msgstr "Padrão"

#: ../contents/ui/config/ConfigEvents.qml
#, c-format
msgid ""
"Join buttons open Google Meet links there; other meeting links open in the "
"default browser. In a command, %u stands for the meeting link. Google "
"account: its number (0, 1, …) or email, as in Google's account switcher; "
"empty uses the app's default."
msgstr ""
"Os botões Participar abrem ali os links do Google Meet; outros links de "
"reunião abrem no navegador padrão. Em um comando, %u representa o link da "
"reunião. Conta do Google: o número (0, 1, …) ou e-mail, como no seletor de "
"contas do Google; vazio usa o padrão do aplicativo."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Other Notifications"
msgstr "Outras notificações"

#: ../contents/ui/config/ConfigEvents.qml
msgid "New invitations for today"
msgstr "Novos convites para hoje"

#: ../contents/ui/config/ConfigEvents.qml
msgid ""
"A notification for each meeting today you haven't answered yet, with Yes, "
"Maybe and No."
msgstr ""
"Uma notificação para cada reunião de hoje que você ainda não respondeu, com "
"Sim, Talvez e Não."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Today's events every morning"
msgstr "Eventos de hoje todas as manhãs"

#: ../contents/ui/config/ConfigEvents.qml
msgid ""
"A notification with today's events once a day, also when the computer is "
"turned on later."
msgstr ""
"Uma notificação com os eventos de hoje uma vez por dia, também quando o "
"computador for ligado mais tarde."

#: ../contents/ui/config/ConfigEvents.qml
msgid "At"
msgstr "Às"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Skip all-day events"
msgstr "Ignorar eventos de dia inteiro"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Skip events I declined"
msgstr "Ignorar eventos que recusei"

#: ../contents/ui/config/ConfigEvents.qml
msgid ""
"Popups and sounds for each kind of notification can also be set in System "
"Settings > Notifications > Event Calendar."
msgstr ""
"Janelas e sons de cada tipo de notificação também podem ser definidos em "
"Configurações do sistema > Notificações > Event Calendar."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Google Account"
msgstr "Conta do Google"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
#: ../contents/ui/config/ConfigTasks.qml
msgid "Google Account %1"
msgstr "Conta do Google %1"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Login failed: %1"
msgstr "Falha no login: %1"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Login complete."
msgstr "Login concluído."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Could not prepare Google login: %1"
msgstr "Não foi possível preparar o login do Google: %1"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Waiting for browser callback..."
msgstr "Aguardando retorno do navegador..."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign-in timed out. Try again."
msgstr "O login expirou. Tente novamente."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed. See logs for details."
msgstr "Falha no login automático. Veja os logs para mais detalhes."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed: invalid callback data."
msgstr "Falha no login automático: dados de retorno inválidos."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed: %1"
msgstr "Falha no login automático: %1"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed: authorization code missing."
msgstr "Falha no login automático: código de autorização ausente."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid ""
"The desktop could not open the browser automatically. Use the login link in "
"Advanced sign-in options instead."
msgstr ""
"A área de trabalho não conseguiu abrir o navegador automaticamente. Use o "
"link de login em Opções avançadas de login."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid ""
"Sign in to show your Google calendars and task lists. Your browser opens to "
"sign in; when access is granted the widget picks it up automatically."
msgstr ""
"Entre para mostrar seus calendários e listas de tarefas do Google. O "
"navegador abre para o login; quando o acesso for concedido, o widget o "
"detecta automaticamente."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign In Again"
msgstr "Entrar novamente"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Reload calendars and task lists"
msgstr "Recarregar calendários e listas de tarefas"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
#: ../contents/ui/config/ConfigTasks.qml
msgid "Remove Account"
msgstr "Remover conta"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
#: ../contents/ui/config/ConfigTasks.qml
msgid "Remove"
msgstr "Remover"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid ""
"Google access for this account expired or was revoked. Sign in again to "
"reconnect it (the account and its settings are kept)."
msgstr ""
"O acesso do Google para esta conta expirou ou foi revogado. Entre novamente "
"para reconectá-la (a conta e suas configurações são mantidas)."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "The widget was updated. Sign in again to keep this account in sync."
msgstr ""
"O widget foi atualizado. Entre novamente para manter esta conta sincronizada."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "No calendars loaded yet. Use the reload button."
msgstr "Nenhum calendário carregado ainda. Use o botão de recarregar."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Task lists are chosen on the Tasks page."
msgstr "As listas de tarefas são escolhidas na página Tarefas."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Add Account…"
msgstr "Adicionar conta…"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign in with Google…"
msgstr "Entrar com o Google…"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Waiting for the browser sign-in…"
msgstr "Aguardando o login no navegador…"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Advanced sign-in options"
msgstr "Opções avançadas de login"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Your own Google OAuth client, or pasting the sign-in code by hand"
msgstr ""
"Seu próprio cliente OAuth do Google ou colar o código de login manualmente"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Client Credentials"
msgstr "Credenciais do cliente"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid ""
"Using a previously stored Google OAuth client for compatibility. If login "
"still fails, add your own client ID and client secret."
msgstr ""
"Usando um cliente OAuth do Google armazenado anteriormente, por "
"compatibilidade. Se o login ainda falhar, adicione seu próprio ID e segredo "
"do cliente."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Try desktop built-in client (no secret)"
msgstr "Tentar o cliente desktop embutido (sem segredo)"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Client ID"
msgstr "ID do cliente"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Optional"
msgstr "Opcional"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
