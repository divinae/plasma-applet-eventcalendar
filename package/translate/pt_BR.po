msgstr " min"

#: ../contents/ui/config/ConfigClock.qml
msgid "Progress of the current meeting"
msgstr "Progresso da reunião atual"

#: ../contents/ui/config/ConfigClock.qml
msgid "A thin bar under the meeting's name, in its calendar's color."
msgstr "Uma barra fina sob o nome da reunião, na cor do seu calendário."

#: ../contents/ui/config/ConfigClock.qml
msgid "Middle-click the clock to join the current or next meeting."
msgstr ""
"Clique com o botão do meio no relógio para participar da reunião atual ou da "
"próxima."

#: ../contents/ui/config/ConfigClock.qml
msgid "Show background"
msgstr "Mostrar fundo"

#: ../contents/ui/config/ConfigClock.qml
msgid "Desktop widget"
msgstr "Widget da área de trabalho"

#: ../contents/ui/config/ConfigClock.qml
