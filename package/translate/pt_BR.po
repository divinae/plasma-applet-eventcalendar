msgstr " min"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Use the reminder times set in Google Calendar"
msgstr "Usar os horários de lembrete definidos no Google Agenda"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Keep until dismissed"
msgstr "Manter até ser dispensado"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Hide after"
