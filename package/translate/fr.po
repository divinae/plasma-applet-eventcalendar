msgctxt "notification timeout"
msgid "System default"
msgstr "Valeur du système"

#: ../contents/ui/config/ConfigEvents.qml
msgid ""
"System default: as set in System Settings > Notifications. A reminder hidden "
"after a set time isn't kept in the notification history."
msgstr ""
"Valeur du système : comme réglé dans Configuration du système > "
"Notifications. Un rappel masqué après un délai fixe n'est pas conservé dans "
"l'historique des notifications."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Snooze"
msgstr "Répéter"

#: ../contents/ui/config/ConfigEvents.qml
msgid "0 = no Snooze button"
msgstr "0 = pas de bouton Répéter"

