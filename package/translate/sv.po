#: ../contents/ui/config/ConfigEvents.qml
#, c-format
msgid "Join buttons open Google Meet links there; other meeting links open in the default browser. In a command, %u stands for the meeting link. Google account: its number (0, 1, …) or email, as in Google's account switcher; empty uses the app's default."
msgstr "Anslut-knappar öppnar Google Meet-länkar där; andra möteslänkar öppnas i standardwebbläsaren. I ett kommando står %u för möteslänken. Google-konto: dess nummer (0, 1, …) eller e-post, som i Googles kontoväxlare; tomt använder appens standard."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Meetings"
msgstr "Möten"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Open the meeting link when a meeting starts"
msgstr "Öppna möteslänken när ett möte börjar"

#: ../contents/ui/config/ConfigEvents.qml
msgid "For meetings you accepted or organize, not marked as ended."
msgstr "För möten som du har accepterat eller organiserar och som inte är markerade som avslutade."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Pause music and videos when joining a meeting"
msgstr "Pausa musik och videor när du ansluter till ett möte"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Players that are playing (eg: Spotify, Elisa, a video in the browser), when a Join button opens a meeting or it opens when the meeting starts."
msgstr "Spelare som spelar (t.ex. Spotify, Elisa, en video i webbläsaren), när en Anslut-knapp öppnar ett möte eller det öppnas när mötet börjar."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Do Not Disturb during meetings"
msgstr "Stör ej under möten"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Plasma's Do Not Disturb from the start until the end of a meeting with guests or a meeting link. Mark as Ended turns it off."
msgstr "Plasmas Stör ej från början till slutet av ett möte med gäster eller en möteslänk. Markera som avslutat stänger av det."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Only meetings I accepted"
msgstr "Endast möten jag har accepterat"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Invitations"
msgstr "Inbjudningar"

#: ../contents/ui/config/ConfigEvents.qml
msgid "New invitations for today"
msgstr "Nya inbjudningar för idag"

#: ../contents/ui/config/ConfigEvents.qml
msgid "A notification for each meeting today you haven't answered yet, with Yes, Maybe and No."
msgstr "En underrättelse för varje möte idag som du inte har svarat på, med Ja, Kanske och Nej."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Daily Agenda"
msgstr "Daglig dagordning"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Today's events every morning"
msgstr "Dagens händelser varje morgon"

#: ../contents/ui/config/ConfigEvents.qml
msgid "A notification with today's events once a day, also when the computer is turned on later."
msgstr "En avisering med dagens händelser en gång om dagen, även när datorn startas senare."

#: ../contents/ui/config/ConfigEvents.qml
msgid "At"
msgstr "Kl."

#: ../contents/ui/config/ConfigEvents.qml
msgid "All Event Notifications"
msgstr "Alla händelseunderrättelser"

#: ../contents/ui/config/ConfigEvents.qml
msgid "\"Join meeting\" button"
msgstr "Knappen \"Anslut till möte\""

#: ../contents/ui/config/ConfigEvents.qml
msgid "In the notification when a meeting starts."
msgstr "I aviseringen när ett möte börjar."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Skip all-day events"
msgstr "Hoppa över heldagshändelser"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Skip events I declined"
msgstr "Hoppa över händelser jag har tackat nej till"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Popups and sounds for each kind of notification can also be set in System Settings > Notifications > Event Calendar."
msgstr "Poppuppfönster och ljud för varje typ av underrättelse kan också ställas in i Systeminställningar > Underrättelser > Event Calendar."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Google Account"
msgstr "Google-konto"

#: ../contents/ui/config/ConfigGoogleCalendar.qml ../contents/ui/config/ConfigTasks.qml
msgid "Google Account %1"
msgstr "Google-konto %1"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Login failed: %1"
msgstr "Inloggning misslyckades: %1"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Login complete."
msgstr "Inloggningen är klar."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Could not prepare Google login: %1"
msgstr "Kunde inte förbereda Google-inloggning: %1"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Waiting for browser callback..."
msgstr "Väntar på återanrop från webbläsaren..."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign-in timed out. Try again."
msgstr "Inloggningen tog för lång tid. Försök igen."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed. See logs for details."
msgstr "Automatisk inloggning misslyckades. Se loggarna för detaljer."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed: invalid callback data."
msgstr "Automatisk inloggning misslyckades: ogiltiga återanropsdata."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed: %1"
msgstr "Automatisk inloggning misslyckades: %1"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed: authorization code missing."
msgstr "Automatisk inloggning misslyckades: auktoriseringskod saknas."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "The desktop could not open the browser automatically. Use the login link in Advanced sign-in options instead."
msgstr "Skrivbordet kunde inte öppna webbläsaren automatiskt. Använd inloggningslänken under Avancerade inloggningsalternativ i stället."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign in to show your Google calendars and task lists. Your browser opens to sign in; when access is granted the widget picks it up automatically."
msgstr "Logga in för att visa dina Google-kalendrar och uppgiftslistor. Webbläsaren öppnas för inloggning; när åtkomst har beviljats upptäcker komponenten det automatiskt."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign In Again"
msgstr "Logga in igen"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Reload calendars and task lists"
msgstr "Läs in kalendrar och uppgiftslistor igen"

#: ../contents/ui/config/ConfigGoogleCalendar.qml ../contents/ui/config/ConfigTasks.qml
msgid "Remove Account"
msgstr "Ta bort konto"

#: ../contents/ui/config/ConfigGoogleCalendar.qml ../contents/ui/config/ConfigTasks.qml
msgid "Remove"
msgstr "Ta bort"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Google access for this account expired or was revoked. Sign in again to reconnect it (the account and its settings are kept)."
msgstr "Googleåtkomsten för det här kontot har gått ut eller återkallats. Logga in igen för att återansluta det (kontot och dess inställningar behålls)."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "The widget was updated. Sign in again to keep this account in sync."
msgstr "Komponenten har uppdaterats. Logga in igen för att hålla kontot synkroniserat."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "No calendars loaded yet. Use the reload button."
msgstr "Inga kalendrar har lästs in än. Använd knappen för att läsa in igen."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Task lists are chosen on the Tasks page."
msgstr "Uppgiftslistor väljs på sidan Uppgifter."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Add Account…"
msgstr "Lägg till konto…"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign in with Google…"
msgstr "Logga in med Google…"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Waiting for the browser sign-in…"
msgstr "Väntar på inloggning i webbläsaren…"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Advanced sign-in options"
msgstr "Avancerade inloggningsalternativ"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Your own Google OAuth client, or pasting the sign-in code by hand"
msgstr "Din egen Google OAuth-klient, eller klistra in inloggningskoden för hand"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Client Credentials"
msgstr "Klientuppgifter"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Using a previously stored Google OAuth client for compatibility. If login still fails, add your own client ID and client secret."
msgstr "Använder en tidigare sparad Google OAuth-klient för kompatibilitet. Om inloggningen fortfarande misslyckas, lägg till ditt eget klient-id och din klienthemlighet."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Try desktop built-in client (no secret)"
msgstr "Prova skrivbordets inbyggda klient (ingen hemlighet)"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Client ID"
msgstr "Klient-id"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Optional"
msgstr "Valfritt"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Client Secret"
msgstr "Klienthemlighet"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Leave these empty to use the built-in client. A custom client must be a Google Cloud OAuth Desktop client, or a Web client with its secret and the redirect URI set to %1."
