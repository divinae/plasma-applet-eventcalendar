msgid "This isn't a settings file of Event Calendar."
msgstr "Αυτό δεν είναι αρχείο ρυθμίσεων του Event Calendar."

#: ../contents/ui/config/ConfigGeneral.qml
msgid "Imported %1 setting. Press Apply or OK to keep it."
msgid_plural "Imported %1 settings. Press Apply or OK to keep them."
msgstr[0] "Εισήχθη %1 ρύθμιση. Πατήστε Εφαρμογή ή OK για να την κρατήσετε."
msgstr[1] ""
"Εισήχθησαν %1 ρυθμίσεις. Πατήστε Εφαρμογή ή OK για να τις κρατήσετε."

