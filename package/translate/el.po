#: ../contents/ui/config/ConfigTasks.qml
msgid "Smart recognition in Add a task"
msgstr "Έξυπνη αναγνώριση στην Προσθήκη εργασίας"

#: ../contents/ui/config/ConfigTasks.qml
msgid ""
"Words like \"tomorrow 17:00\", \"!high\", \"#List\" or \"every week\" set "
