msgid ""
"Not imported (not in this version, a password or sign-in, or a value of "
"another kind): %2"
msgid_plural ""
"%1 not imported (not in this version, passwords or sign-ins, or values of "
"another kind): %2"
msgstr[0] ""
"Δεν εισήχθη (δεν υπάρχει σε αυτή την έκδοση, κωδικός ή σύνδεση, ή τιμή άλλου "
"είδους): %2"
msgstr[1] ""
"%1 δεν εισήχθησαν (δεν υπάρχουν σε αυτή την έκδοση, κωδικοί ή συνδέσεις, ή "
