msgid "\"Join meeting\" and \"Open in Calendar\" buttons"
msgstr "\"Liity kokoukseen\"- ja \"Avaa kalenterissa\" -painikkeet"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Skip all-day events"
msgstr "Ohita koko päivän tapahtumat"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Skip events I declined"
msgstr "Ohita tapahtumat, joista olen kieltäytynyt"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Popups and sounds for each kind of notification can also be set in System Settings > Notifications > Event Calendar."
msgstr "Kunkin ilmoitustyypin ponnahdukset ja äänet voi asettaa myös kohdassa Järjestelmäasetukset > Ilmoitukset > Event Calendar."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Google Account"
