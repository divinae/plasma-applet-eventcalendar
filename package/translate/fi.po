#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Login complete."
msgstr "Kirjautuminen valmis."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Could not prepare Google login: %1"
msgstr "Google-kirjautumisen valmistelu epäonnistui: %1"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Waiting for browser callback..."
msgstr "Odotetaan selaimen paluukutsua..."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Waiting for the helper page to send the code..."
msgstr "Odotetaan, että apusivu lähettää koodin..."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign-in timed out. Try again."
msgstr "Kirjautuminen aikakatkaistiin. Yritä uudelleen."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed. See logs for details."
msgstr "Automaattinen kirjautuminen epäonnistui. Katso lisätiedot lokeista."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed: invalid callback data."
msgstr "Automaattinen kirjautuminen epäonnistui: virheelliset paluukutsun tiedot."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed: %1"
msgstr "Automaattinen kirjautuminen epäonnistui: %1"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed: authorization code missing."
msgstr "Automaattinen kirjautuminen epäonnistui: valtuutuskoodi puuttuu."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "The desktop could not open the browser automatically. Use the login link in Advanced sign-in options instead."
msgstr "Työpöytä ei voinut avata selainta automaattisesti. Käytä sen sijaan kirjautumislinkkiä kohdassa Kirjautumisen lisäasetukset."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign in to show your Google calendars and task lists. Your browser opens to sign in; when access is granted the widget picks it up automatically."
msgstr "Kirjaudu sisään, niin Google-kalenterisi ja tehtäväluettelosi näytetään. Selain avautuu kirjautumista varten; kun käyttöoikeus on myönnetty, sovelma huomaa sen automaattisesti."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign In Again"
msgstr "Kirjaudu uudelleen"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Reload calendars and task lists"
msgstr "Lataa kalenterit ja tehtäväluettelot uudelleen"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Remove Account"
msgstr "Poista tili"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Remove"
msgstr "Poista"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Google access for this account expired or was revoked. Sign in again to reconnect it (the account and its settings are kept)."
msgstr "Tämän tilin Google-käyttöoikeus on vanhentunut tai peruttu. Yhdistä tili uudelleen kirjautumalla sisään (tili ja sen asetukset säilytetään)."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "The widget was updated. Sign in again to keep this account in sync."
msgstr "Sovelma on päivitetty. Kirjaudu uudelleen, jotta tili pysyy synkronoituna."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "No calendars loaded yet. Use the reload button."
msgstr "Kalentereita ei ole vielä ladattu. Käytä uudelleenlatauspainiketta."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Task Lists"
msgstr "Tehtäväluettelot"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Add Account…"
msgstr "Lisää tili…"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign in with Google…"
msgstr "Kirjaudu Googlella…"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Waiting for the browser sign-in…"
msgstr "Odotetaan kirjautumista selaimessa…"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Advanced sign-in options"
msgstr "Kirjautumisen lisäasetukset"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Your own Google OAuth client, or pasting the sign-in code by hand"
msgstr "Oma Google OAuth -asiakas tai kirjautumiskoodin liittäminen käsin"

