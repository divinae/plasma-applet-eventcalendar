#: ../contents/ui/config/ConfigEvents.qml
#, c-format
msgid "Join buttons open Google Meet links there; other meeting links open in the default browser. In a command, %u stands for the meeting link. Google account: its number (0, 1, …) or email, as in Google's account switcher; empty uses the app's default."
msgstr "Liity-painikkeet avaavat Google Meet -linkit siinä; muut kokouslinkit avautuvat oletusselaimessa. Komennossa %u tarkoittaa kokouslinkkiä. Google-tili: sen numero (0, 1, …) tai sähköposti kuten Googlen tilinvaihtajassa; tyhjä käyttää sovelluksen oletusta."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Meetings"
msgstr "Kokoukset"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Open the meeting link when a meeting starts"
msgstr "Avaa kokouslinkki, kun kokous alkaa"

#: ../contents/ui/config/ConfigEvents.qml
msgid "For meetings you accepted or organize, not marked as ended."
msgstr "Kokouksille, jotka olet hyväksynyt tai järjestät ja joita ei ole merkitty päättyneiksi."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Do Not Disturb during meetings"
msgstr "Älä häiritse -tila kokousten aikana"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Plasma's Do Not Disturb from the start until the end of a meeting with guests or a meeting link. Mark as Ended turns it off."
msgstr "Plasman Älä häiritse -tila kokouksen alusta loppuun, kun kokouksessa on vieraita tai kokouslinkki. \"Merkitse päättyneeksi\" poistaa sen käytöstä."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Only meetings I accepted"
msgstr "Vain hyväksymäni kokoukset"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Invitations"
msgstr "Kutsut"

#: ../contents/ui/config/ConfigEvents.qml
msgid "New invitations for today"
msgstr "Uudet kutsut tälle päivälle"

#: ../contents/ui/config/ConfigEvents.qml
msgid "A notification for each meeting today you haven't answered yet, with Yes, Maybe and No."
msgstr "Ilmoitus jokaisesta tämän päivän tapaamisesta, johon et ole vielä vastannut, ja valinnat Kyllä, Ehkä ja Ei."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Daily Agenda"
msgstr "Päivän agenda"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Today's events every morning"
msgstr "Päivän tapahtumat joka aamu"

#: ../contents/ui/config/ConfigEvents.qml
msgid "A notification with today's events once a day, also when the computer is turned on later."
msgstr "Ilmoitus päivän tapahtumista kerran päivässä, myös jos tietokone käynnistetään vasta myöhemmin."

#: ../contents/ui/config/ConfigEvents.qml
msgid "At"
msgstr "Klo"

#: ../contents/ui/config/ConfigEvents.qml
msgid "All Event Notifications"
msgstr "Kaikki tapahtumailmoitukset"

