msgstr "Uporabi čase opomnikov, nastavljene v Googlovem koledarju"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Keep until dismissed"
msgstr "Obdrži do opustitve"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Snooze"
msgstr "Dremež"

#: ../contents/ui/config/ConfigEvents.qml
msgid "0 = no Snooze button"
msgstr "0 = brez gumba Dremež"

#: ../contents/ui/config/ConfigEvents.qml
msgid "When an Event Starts"
msgstr "Ko se dogodek začne"

#: ../contents/ui/config/ConfigEvents.qml
