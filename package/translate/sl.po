msgstr "Prikaži obvestilo"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Critical"
msgstr "Kritično"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Shown even in Do Not Disturb"
msgstr "Prikazano tudi v načinu Ne moti"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Sounds"
msgstr "Zvoki"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Reminder"
msgstr "Opomnik"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Event starts"
msgstr "Začetek dogodka"

#: ../contents/ui/config/ConfigEvents.qml
msgid "All Event Notifications"
msgstr "Vsa obvestila o dogodkih"

#: ../contents/ui/config/ConfigEvents.qml
