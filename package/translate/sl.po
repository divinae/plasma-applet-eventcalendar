#: ../contents/ui/config/ConfigEvents.qml
msgid ""
"System default: as set in System Settings > Notifications. A reminder hidden "
"after a set time isn't kept in the notification history."
msgstr ""
"Sistemska privzeta vrednost: kot je nastavljeno v Sistemskih nastavitvah > "
"Obvestila. Opomnik, skrit po nastavljenem času, ne ostane v zgodovini "
"obvestil."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Snooze"
msgstr "Dremež"

#: ../contents/ui/config/ConfigEvents.qml
msgid "0 = no Snooze button"
msgstr "0 = brez gumba Dremež"

