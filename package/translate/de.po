msgstr "Systemvorgabe"

#: ../contents/ui/config/ConfigEvents.qml
msgid ""
"System default: as set in System Settings > Notifications. A reminder hidden "
"after a set time isn't kept in the notification history."
msgstr ""
"Systemvorgabe: wie in den Systemeinstellungen > Benachrichtigungen "
"eingestellt. Eine nach fester Zeit ausgeblendete Erinnerung bleibt nicht im "
"Benachrichtigungsverlauf."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Snooze"
msgstr "Schlummern"

#: ../contents/ui/config/ConfigEvents.qml
msgid "0 = no Snooze button"
msgstr "0 = keine Schlummern-Schaltfläche"

