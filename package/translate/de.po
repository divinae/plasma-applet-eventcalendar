msgid "Event starts"
msgstr "Ereignisbeginn"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Google Meet"
msgstr "Google Meet"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Open meeting links in"
