msgstr "Begivenhedsdetaljer i widgetten"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Google Calendar in the browser"
msgstr "Google Kalender i browseren"

#: ../contents/ui/config/ConfigEvents.qml
