msgstr[0] "%1 sekund"
msgstr[1] "%1 sekunder"

#: ../contents/ui/config/ConfigEvents.qml
msgctxt "notification timeout"
msgid "System default"
msgstr "Systemstandard"

#: ../contents/ui/config/ConfigEvents.qml
msgid ""
"System default: as set in System Settings > Notifications. A reminder hidden "
"after a set time isn't kept in the notification history."
msgstr ""
"Systemstandard: som angivet i Systemindstillinger > Underretninger. En "
"påmindelse, der skjules efter en fast tid, gemmes ikke i "
"underretningshistorikken."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Snooze"
msgstr "Udsæt"

#: ../contents/ui/config/ConfigEvents.qml
msgid "0 = no Snooze button"
msgstr "0 = ingen Udsæt-knap"

