msgid "Use the reminder times set in Google Calendar"
msgstr "Brug påmindelsestiderne fra Google Kalender"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Keep until dismissed"
msgstr "Behold indtil den afvises"

#: ../contents/ui/config/ConfigEvents.qml
msgid "Hide after"
msgstr "Skjul efter"

