msgid "Auto login failed: %1"
msgstr "Falha no início de sessão automático: %1"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed: authorization code missing."
msgstr "Falha no início de sessão automático: falta o código de autorização."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "The desktop could not open the browser automatically. Use the login link in Advanced sign-in options instead."
msgstr "O ambiente de trabalho não conseguiu abrir o navegador automaticamente. Utilize antes a ligação de início de sessão nas Opções avançadas de início de sessão."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign in to show your Google calendars and task lists. Your browser opens to sign in; when access is granted the widget picks it up automatically."
msgstr "Inicie sessão para mostrar os seus calendários e listas de tarefas Google. O navegador abre-se para iniciar sessão; quando o acesso for concedido, o widget deteta-o automaticamente."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign In Again"
msgstr "Iniciar sessão novamente"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Reload calendars and task lists"
msgstr "Recarregar calendários e listas de tarefas"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Remove Account"
msgstr "Remover conta"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Remove"
msgstr "Remover"

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Google access for this account expired or was revoked. Sign in again to reconnect it (the account and its settings are kept)."
msgstr "O acesso Google desta conta expirou ou foi revogado. Inicie sessão novamente para voltar a ligá-la (a conta e as suas definições são mantidas)."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "The widget was updated. Sign in again to keep this account in sync."
msgstr "O widget foi atualizado. Inicie sessão novamente para manter esta conta sincronizada."

