msgid "Waiting for the helper page to send the code..."
msgstr "A aguardar que a página auxiliar envie o código..."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Sign-in timed out. Try again."
msgstr "O início de sessão expirou. Tente novamente."

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgid "Auto login failed. See logs for details."
msgstr "Falha no início de sessão automático. Consulte os registos para mais detalhes."

