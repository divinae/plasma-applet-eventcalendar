#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgctxt "%1 = email addresses"
msgid "KDE PIM (Akonadi) already brings in the Google calendars of %1, read-only. Sign in here as well to answer invitations, edit and delete events and join meetings from the widget. Events of an account synced both ways are shown once, from the sign-in here."
msgstr ""

#: ../contents/ui/config/ConfigGoogleCalendar.qml
msgctxt "%1 = email addresses"
msgid "Also synced by KDE PIM (Akonadi): %1. Their events are shown once, from the sign-in here, where they can be answered and edited."
msgstr ""

