#: ../contents/ui/config/ConfigEvents.qml
#, c-format
msgid "Join buttons open Google Meet links there; other meeting links open in the default browser. In a command, %u stands for the meeting link. Google account: its number (0, 1, …) or email, as in Google's account switcher; empty uses the app's default."
msgstr "Los botones Unirse abren ahí los enlaces de Google Meet; los demás enlaces de reunión se abren en el navegador predeterminado. En una orden, %u representa el enlace. Cuenta de Google: su número (0, 1, …) o correo, como en el selector de cuentas de Google; vacío usa el predeterminado de la aplicación."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Other Notifications"
msgstr "Otras notificaciones"

#: ../contents/ui/config/ConfigEvents.qml
msgid "New invitations for today"
msgstr "Invitaciones nuevas para hoy"

#: ../contents/ui/config/ConfigEvents.qml
msgid "A notification for each meeting today you haven't answered yet, with Yes, Maybe and No."
msgstr "Una notificación por cada reunión de hoy que aún no has respondido, con Sí, Quizás y No."

#: ../contents/ui/config/ConfigEvents.qml
msgid "Today's events every morning"
msgstr "Eventos de hoy cada mañana"

#: ../contents/ui/config/ConfigEvents.qml
msgid "A notification with today's events once a day, also when the computer is turned on later."
msgstr "Una notificación con los eventos de hoy una vez al día, también si el equipo se enciende más tarde."

