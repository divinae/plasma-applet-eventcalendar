			<default>free</default>
		</entry>
		<!-- WeatherCanada -->
		<entry name="weatherCanadaCityId" type="string">
			<default></default>
		</entry>
		<!-- Settings -->
		<entry name="openMeteoLatitude" type="double">
			<default>0</default>
		</entry>
		<entry name="openMeteoLongitude" type="double">
			<default>0</default>
		</entry>
		<entry name="openMeteoLocationName" type="string">
			<default></default>
		</entry>
		<!-- Day view: the panels beside the hours (Settings > Views > Day view shows). -->
		<entry name="dayShowMiniMonth" type="bool">
			<default>true</default>
