			<default>true</default>
		</entry>
		<entry name="dayAllDayTiles" type="bool">
			<!-- Day view: three all-day events or more side by side, three in a row (the tooltip has the full text). -->
			<default>true</default>
		</entry>
		<entry name="weatherShowInViews" type="bool">
			<default>true</default>
		</entry>
		<entry name="weatherService" type="string">
			<!-- enum: OpenMeteo, OpenWeatherMap, WeatherCanada -->
			<default>OpenMeteo</default>
		</entry>
		<entry name="weatherUnits" type="string">
			<default>metric</default>
		</entry>
		<entry name="weatherIconStyle" type="string">
			<!-- enum: system (the icon theme's), yr (bundled) -->
			<default>system</default>
		</entry>
		<entry name="weatherChartStyle" type="string">
			<!-- The Weather panel's hourly chart. enum: simple, fancy -->
			<default>simple</default>
		</entry>
		<entry name="weatherChartLargeIcons" type="bool">
			<default>false</default>
		</entry>
		<entry name="weatherChartRainAmounts" type="bool">
			<default>false</default>
		</entry>
		<entry name="weatherIconBackground" type="string">
			<!-- The Weather panel's current weather icon. enum: sky (colors after the weather), subtle, none -->
			<default>sky</default>
		</entry>
		<entry name="meteogramHours" type="uint">
			<default>30</default>
		</entry>
	</group>

</kcfg>
